{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "analyze:financial-baseline": "node scripts/analyze-financial-ledger-baseline.mjs --verify",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "server:dev": "tsx server.ts",
    "server:build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "server:start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-typescript-tests.mjs",
    "test:financial-baseline": "node --test scripts/analyze-financial-ledger-baseline.test.mjs",
    "test:financial-production-audit": "node --test scripts/financial-production-audit.test.mjs",
    "test:financial-debt-recovery": "node --import tsx --test src/domain/finance/automaticShortfallRecovery.test.ts",
    "test:financial-final-narrative": "node --import tsx --test src/utils/finalFinancialNarrativeAuthority.test.ts src/services/finalOutcome/finalOutcomeService.test.ts",
    "test:financial-journey-isolation": "node --test scripts/real-browser-journey-runner.test.mjs",
    "test:generation-recovery": "node --import tsx --test src/utils/simulationNodeRetry.test.ts scripts/real-browser-journey-runner.test.mjs scripts/financial-real-browser-audit-helpers.test.mjs",
    "test:generation-candidate-repair": "node --import tsx --test src/services/simulation/nodeCandidateCore.test.ts scripts/generation-latency-gate.test.mjs",
    "test:financial-business-boundary": "node --import tsx --test src/domain/finance/validateFinancialProposals.test.ts src/domain/finance/reconcileCareerIncomeAtomicity.test.ts",
    "test:financial-opening-assets": "node --import tsx --test src/domain/finance/openingFinancialAuthority.test.ts src/domain/finance/openingFinancialFacts.test.ts src/domain/finance/assetTransaction.test.ts src/domain/finance/validateFinancialProposals.test.ts src/domain/finance/migrateFinancialLedgerV2ToV3.test.ts",
    "test:financial-m2": "node --import tsx --test src/domain/finance/reduceFinancialLedger.test.ts",
    "test:financial-m5": "node --import tsx --test src/domain/career/careerState.test.ts src/domain/finance/recurringLifecycle.test.ts src/domain/finance/debtLifecycle.test.ts src/domain/finance/businessLifecycle.test.ts src/domain/finance/financialProblemCoverage.test.ts",
    "test:financial-m7": "node --import tsx --test src/domain/finance/financialM7Gate.test.ts src/domain/finance/commitFinancialDomainTransaction.test.ts src/services/simulation/simulationService.test.ts src/utils/simulationTransaction.test.ts scripts/financial-real-browser-audit-helpers.test.mjs",
    "test:financial-m7-focused": "node --import tsx --test src/domain/finance/financialM7FocusedGate.test.ts src/domain/finance/openingFinancialFacts.test.ts src/domain/finance/financialM7Gate.test.ts src/services/simulation/financialM7FocusedSimulation.test.ts",
    "test:financial-wealth-trust": "node --import tsx --test src/domain/finance/financialNodeAcceptanceGate.test.ts src/domain/finance/lifeStageExpenseLifecycle.test.ts src/utils/financialState.test.ts src/services/simulation/simulationService.test.ts",
    "test:opening-expense-facts": "node --import tsx --test src/domain/finance/openingFinancialFacts.test.ts src/domain/finance/openingFinancialAuthority.test.ts src/domain/finance/initializeOpeningFinancialLedger.test.ts",
    "test:financial-expense-lifecycle": "node --import tsx --test src/config/financialGatePolicy.test.ts src/domain/finance/evidenceMatching.test.ts src/domain/finance/expenseExplicitChangeAuthority.test.ts src/domain/finance/expenseEstimationPolicyV2.test.ts src/domain/finance/expenseGoldCorpusE2E.test.ts src/domain/finance/expenseResponsibility.test.ts src/domain/finance/reconcileExpenseCommitments.test.ts src/domain/finance/expenseLifecycleReview.test.ts src/domain/finance/expenseRealismLifecycle.test.ts src/domain/finance/personalExpenseSummary.test.ts src/domain/finance/migrateFinancialLedgerV3ToV4.test.ts src/domain/finance/normalizeFinancialProposals.test.ts src/domain/finance/commitFinancialDomainTransaction.test.ts src/domain/finance/validateFinancialProposals.test.ts src/domain/finance/financialNodeAcceptanceGate.test.ts src/services/simulation/expenseLifecycleWorldStatePreview.test.ts src/services/simulation/financialNarrativeCoverage.test.ts src/services/simulation/simulationService.test.ts src/utils/personTimeline.test.ts",
    "test:financial-expense-audit": "node --test scripts/financial-expense-audit.test.mjs scripts/analyze-financial-real-browser-run.test.mjs",
    "test:financial-debt-d1a": "node --import tsx --test --test-name-pattern='D1-(04|05|06|07|08|16)' src/domain/finance/debtDistressLedger.test.ts",
    "test:financial-debt-d1b": "node --import tsx --test --test-name-pattern='D1-(01|02|03|09|10|11|12|13|14|15|17|18|19|20)' src/domain/finance/debtDistressLedger.test.ts",
    "test:financial-debt-d1": "pnpm test:financial-debt-d1a && pnpm test:financial-debt-d1b",
    "test:financial-debt-d2": "node --import tsx --test --test-name-pattern='D2-' src/domain/finance/debtHealth.test.ts src/utils/debtHistoryAndTransaction.test.ts",
    "test:financial-debt-d3": "node --import tsx --test src/data/debtLifeEvents.test.ts",
    "test:financial-debt-d4": "node --import tsx --test --test-name-pattern='D4-' src/utils/financialDebtArc.test.ts src/utils/debtHistoryAndTransaction.test.ts",
    "test:financial-debt-d4.5": "node --import tsx --test src/utils/debtNarrativeAuthority.test.ts src/utils/financialNarrative.test.ts src/services/simulation/prompts.test.ts src/services/simulation/simulationService.test.ts",
    "test:financial-debt": "pnpm test:financial-debt-d1 && pnpm test:financial-debt-d2 && pnpm test:financial-debt-d3 && pnpm test:financial-debt-d4 && pnpm test:financial-debt-d4.5",
    "analyze:financial-debt-browser": "node scripts/analyze-debt-real-browser-run.mjs",
    "test:financial-production-blockers": "pnpm test:financial-production-audit && pnpm test:financial-debt-recovery && pnpm test:financial-final-narrative && pnpm test:financial-journey-isolation && pnpm test:generation-recovery && pnpm test:generation-candidate-repair && pnpm test:financial-business-boundary && pnpm test:financial-opening-assets && pnpm test:opening-expense-facts && pnpm test:financial-expense-lifecycle && pnpm test:financial-expense-audit && pnpm test:financial-debt && pnpm test:financial-m5 && pnpm test:financial-m7 && pnpm test:financial-wealth-trust"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
